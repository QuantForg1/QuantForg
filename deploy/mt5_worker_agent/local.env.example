# Local Windows MT5 worker agent — copy to local.env (DO NOT COMMIT).
# Never put live Weltrade passwords here. Never paste secrets into GitHub/Cursor chat.

# Outbound Railway / API (https required except localhost dry-run)
QUANTFORG_API_BASE_URL=https://quantforg-production.up.railway.app
WORKER_SERVICE_TOKEN=replace-with-long-random-service-token

# Isolated portable slot root (outside Program Files LIVE install)
QF_MT5_SLOT_ROOT=C:\QuantForg-Workspace\mt5_worker_slots
QF_MT5_LOCAL_SLOTS=demo-a,demo-b,demo-c
QF_WORKER_HOST_CODE=local-windows-1
# Soft cap on concurrent portable terminals (existing host — no new VPS)
QF_MT5_MAX_CONCURRENT_PORTABLES=2

# LIVE terminal path — workers refuse this unless override is true (keep false)
QF_LIVE_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
QF_ALLOW_WORKER_ON_LIVE_TERMINAL=false

# Optional evidence path (default: var/mt5_broker_verification.json)
# QF_BROKER_VERIFICATION_EVIDENCE_PATH=

# Per-broker DEMO (approved credentials only — exact portal/email server)
# QF_DEMO_EXNESS_LOGIN=  QF_DEMO_EXNESS_PASSWORD=  QF_DEMO_EXNESS_SERVER=
# QF_DEMO_HFM_LOGIN=  QF_DEMO_HFM_PASSWORD=  QF_DEMO_HFM_SERVER=
# QF_DEMO_IC_MARKETS_LOGIN=  QF_DEMO_IC_MARKETS_PASSWORD=  QF_DEMO_IC_MARKETS_SERVER=
# QF_DEMO_PEPPERSTONE_LOGIN=  QF_DEMO_PEPPERSTONE_PASSWORD=  QF_DEMO_PEPPERSTONE_SERVER=
# QF_DEMO_FP_MARKETS_LOGIN=  QF_DEMO_FP_MARKETS_PASSWORD=  QF_DEMO_FP_MARKETS_SERVER=
# QF_DEMO_XM_LOGIN=  QF_DEMO_XM_PASSWORD=  QF_DEMO_XM_SERVER=

# Per-broker LIVE authentication material (read/login verify only — no live orders)
# QF_LIVE_EXNESS_LOGIN=  QF_LIVE_EXNESS_PASSWORD=  QF_LIVE_EXNESS_SERVER=
# QF_LIVE_HFM_LOGIN=  QF_LIVE_HFM_PASSWORD=  QF_LIVE_HFM_SERVER=
# QF_LIVE_IC_MARKETS_LOGIN=  QF_LIVE_IC_MARKETS_PASSWORD=  QF_LIVE_IC_MARKETS_SERVER=
# QF_LIVE_PEPPERSTONE_LOGIN=  QF_LIVE_PEPPERSTONE_PASSWORD=  QF_LIVE_PEPPERSTONE_SERVER=
# QF_LIVE_FP_MARKETS_LOGIN=  QF_LIVE_FP_MARKETS_PASSWORD=  QF_LIVE_FP_MARKETS_SERVER=
# QF_LIVE_XM_LOGIN=  QF_LIVE_XM_PASSWORD=  QF_LIVE_XM_SERVER=
