# Local Windows MT5 worker agent — copy to local.env (DO NOT COMMIT).
# local.env is gitignored. Never paste secrets into GitHub, Cursor chat, or logs.
# Never put Weltrade LIVE Program Files passwords here.
#
# After filling approved values, verify one broker at a time:
#   .\deploy\mt5_worker_agent\check_broker_credentials.ps1
#   .\deploy\mt5_worker_agent\verify_demo_broker.ps1 -Broker exness -Slot demo-a -Env demo
#   .\deploy\mt5_worker_agent\verify_demo_broker.ps1 -Broker exness -Slot demo-a -Env live
# Live mode is authentication / account-info only — no LIVE order submit/modify/close.
# Server values must be the exact MT5 server string from the broker portal / terminal
# (never invent names). Worker validates server against broker pattern after login.

# Outbound Railway / API (https required except localhost dry-run)
# Phase 8 demo proofs must use staging — never aim disposable workers at production.
QUANTFORG_API_BASE_URL=https://quantforg-staging.up.railway.app
WORKER_SERVICE_TOKEN=replace-with-long-random-service-token

# Phase 8.7 customer JWT staging acceptance (disposable staging users ONLY — never production)
# QF_STAGING_CUSTOMER_A_JWT=
# QF_STAGING_CUSTOMER_B_JWT=

# Isolated portable slot root (outside Program Files LIVE install)
QF_MT5_SLOT_ROOT=C:\QuantForg-Workspace\mt5_worker_slots
# Only slots that exist on disk (demo-c requires prepare_local_slots first)
QF_MT5_LOCAL_SLOTS=demo-a,demo-b
QF_WORKER_HOST_CODE=local-windows-1
# Soft cap on concurrent portable terminals (existing host — no new VPS)
QF_MT5_MAX_CONCURRENT_PORTABLES=2

# LIVE terminal path — workers refuse this unless override is true (keep false)
QF_LIVE_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
QF_ALLOW_WORKER_ON_LIVE_TERMINAL=false

# Optional evidence path (default: var/mt5_broker_verification.json)
# QF_BROKER_VERIFICATION_EVIDENCE_PATH=

# ---------------------------------------------------------------------------
# Per-broker DEMO — placeholders only. Replace with approved portal values.
# Mid-names match services/mt5_worker_agent/broker_demo_adapters.py _ENV_PREFIX.
# ---------------------------------------------------------------------------

# Exness Demo
QF_DEMO_EXNESS_LOGIN=
QF_DEMO_EXNESS_PASSWORD=
QF_DEMO_EXNESS_SERVER=

