# Production-targeted Windows MT5 worker agent — copy to local.production.env
# (DO NOT COMMIT). Never paste secrets into GitHub, Cursor chat, or logs.
#
# CRITICAL ISOLATION RULES
# - Keep local.env pointed at Staging (existing agent). Do not overwrite it.
# - This file targets Railway Production only.
# - Never set QF_ALLOW_WORKER_ON_LIVE_TERMINAL=true.
# - Never point portable slots at the Weltrade LIVE Program Files terminal.
# - DEMO credentials only until Owner explicitly authorizes LIVE portable verify.
#
# Launch (separate from Staging supervisor):
#   .\deploy\mt5_worker_agent\start_production_supervisor.ps1
#
# Before claiming dispatch_ready:
#   1) WORKER_SERVICE_TOKEN must match Production control-plane token
#   2) Host + slots registered against Production
#   3) Real DEMO MT5 auth on a portable slot
#   4) Fresh heartbeat + login/server verified on Production ops summary

# Production API (https required)
QUANTFORG_API_BASE_URL=https://quantforg-production.up.railway.app
WORKER_SERVICE_TOKEN=replace-with-production-worker-service-token

# Isolated portable slot root (outside Program Files LIVE install)
QF_MT5_SLOT_ROOT=C:\QuantForg-Workspace\mt5_worker_slots_production
QF_MT5_LOCAL_SLOTS=demo-a
QF_WORKER_HOST_CODE=prod-windows-1
QF_MT5_MAX_CONCURRENT_PORTABLES=2

# LIVE terminal path — refuse unless override is true (keep false)
QF_LIVE_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
QF_ALLOW_WORKER_ON_LIVE_TERMINAL=false

# Production DEMO verify placeholders (approved portal values only)
QF_DEMO_WELTRADE_LOGIN=
QF_DEMO_WELTRADE_PASSWORD=
QF_DEMO_WELTRADE_SERVER=
